<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o más: el sistema dibuja la guacamaya en un círculo amarillo sobre rojo. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/pavito_rojo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/pavito_amarillo</item>
        <item name="android:statusBarColor">@color/pavito_rojo</item>
        <item name="android:navigationBarColor">@color/pavito_rojo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
