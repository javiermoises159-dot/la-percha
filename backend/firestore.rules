rules_version = '2';

// Reglas de seguridad de La Percha (base de datos).
// Principio: nadie puede leer ni escribir nada que no sea suyo, y el dinero
// solo lo mueve el administrador (o, más adelante, funciones del servidor).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Ayudas ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function listingOf(id) {
      return get(/databases/$(database)/documents/listings/$(id)).data;
    }

    // ---------- Perfil público ----------
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && isStr(request.resource.data.username, 3, 20)
        && isStr(request.resource.data.city, 2, 40)
        && request.resource.data.keys().hasOnly(['username', 'city', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      // Calificaciones, verificación y bloqueos NO los puede tocar el usuario.
      allow update: if isOwner(uid)
        && changedKeys().hasOnly(['username', 'city'])
        && isStr(request.resource.data.username, 3, 20);
      allow delete: if isAdmin();

      // Datos privados (teléfono, cuenta de cobro, dirección de entrega).
      match /private/{doc} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Favoritos: solo del dueño.
      match /favs/{listingId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- Anuncios ----------
    match /listings/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && isStr(request.resource.data.title, 3, 60)
        && isStr(request.resource.data.description, 0, 500)
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 5000
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 8
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;
      // El vendedor edita su anuncio, pero no puede marcarlo vendido a mano
      // ni cambiar de dueño.
      allow update: if (isOwner(resource.data.sellerId)
          && changedKeys().hasOnly(
            ['title', 'description', 'price', 'size', 'condition', 'category',
             'photos', 'status', 'city'])
          && request.resource.data.status in ['active', 'hidden'])
        || isAdmin();
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    // ---------- Conversaciones ----------
    match /threads/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.sellerId in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && changedKeys().hasOnly(['lastMessage', 'lastAt', 'offer']);

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/threads/$(id)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/threads/$(id)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && isStr(request.resource.data.text, 1, 1000)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;   // los mensajes no se editan
      }
    }

    // ---------- Pedidos (compra protegida) ----------
    match /orders/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.buyerId
            || request.auth.uid == resource.data.sellerId
            || isAdmin());

      // Crea el comprador. El precio debe ser coherente con el anuncio
      // (no se puede inventar un precio) y siempre empieza sin pagar.
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId == listingOf(request.resource.data.listingId).sellerId
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.status == 'esperando_pago'
        && request.resource.data.price is number
        && request.resource.data.price <= listingOf(request.resource.data.listingId).price
        && request.resource.data.price >= listingOf(request.resource.data.listingId).price * 0.5
        && math.abs(request.resource.data.fee - (0.5 + request.resource.data.price * 0.05)) < 0.01
        && request.resource.data.createdAt == request.time;

      // Quién puede mover cada estado:
      //  - comprador: avisa que pagó, confirma recepción, abre disputa, cancela antes de pagar
      //  - vendedor: marca como enviado, cancela antes de pagar
      //  - administrador: verifica el pago (revision -> retenido), libera o devuelve el dinero
      allow update: if signedIn() && (
        isAdmin()
        || (request.auth.uid == resource.data.buyerId
            && changedKeys().hasOnly(['status', 'payRef', 'delivery', 'updatedAt'])
            && ((resource.data.status == 'esperando_pago' && request.resource.data.status in ['revision', 'cancelado'])
                || (resource.data.status == 'enviado' && request.resource.data.status in ['liberado', 'disputa'])))
        || (request.auth.uid == resource.data.sellerId
            && changedKeys().hasOnly(['status', 'tracking', 'updatedAt'])
            && ((resource.data.status == 'retenido' && request.resource.data.status == 'enviado')
                || (resource.data.status == 'esperando_pago' && request.resource.data.status == 'cancelado')))
      );
      allow delete: if false;
    }

    // ---------- Denuncias ----------
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && isStr(request.resource.data.reason, 3, 500);
      allow read, update, delete: if isAdmin();
    }

    // Todo lo demás está prohibido.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
